; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MATHBOUND: Chronicles of the Infinite Knowledge"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/m_emblem.png"

[autoload]

AudioManager="*res://autoload/audio_manager.gd"
MagicManager="*res://autoload/magic_manager.gd"
CodexManager="*res://autoload/codex_manager.gd"
BookManager="*res://autoload/book_manager.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="MATHBOUND- Chronicles of the Infinite Knowledge"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[summer]

version="0.8.3"
